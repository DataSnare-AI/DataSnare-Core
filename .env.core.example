# Local Core preview. Override app/api domains only after DNS and Azure routing exist.
CORE_APP_DOMAIN=localhost
CORE_API_DOMAIN=api.localhost
CORE_HTTP_PORT=8080

# Production prerequisites are intentionally not enabled by the preview compose file:
# DATASNARE_ENV=production
# DATABASE_URL=postgresql://<core-user>:<password>@<azure-postgres-host>:5432/datasnare_core
# AUTH_PROVIDER_URL=https://<configured-identity-provider>
# CORS_ALLOWED_ORIGINS=https://app.datasnare.com
