# Local Core preview. Override app/api domains only after DNS and Azure routing exist.
CORE_APP_DOMAIN=localhost
CORE_API_DOMAIN=api.localhost
CORE_HTTP_PORT=8080

# Staging deployment (docker-compose.staging.yml) requires the existing edge network
# and a Core database URL so login and account APIs are available:
# CORE_EDGE_NETWORK=datasnare_default
# DATABASE_URL=postgresql://<core-user>:<password>@<core-db-host>:5432/datasnare_core

# Production prerequisites are intentionally not enabled by the preview compose file:
# DATASNARE_ENV=production
# DATABASE_URL=postgresql://<core-user>:<password>@<azure-postgres-host>:5432/datasnare_core
# Core username/password identity uses DATABASE_URL and migrations 003/004.
# Configure AIOps separately with CORE_AUTH_PROVIDER_URL=https://api.datasnare.com
# so AIOps can validate Core-issued sessions server-to-server.
# CORS_ALLOWED_ORIGINS=https://app.datasnare.com
